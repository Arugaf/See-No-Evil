  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u0427\u0451\u0440\u0442... \u043A\u0430\u043A \u0436\u0435 \u043D\u0430
    \u043A\u043B\u0430\u043F\u0430\u043D \u0434\u0430\u0432\u0438\u0442...\r\n\u0410
    \u043F\u043E\u043F\u0440\u044B\u0433\u0430\u0442\u044C \u0442\u043E \u0438 \u043D\u0435\u043B\u044C\u0437\u044F!
    (\u043F\u0440\u043E\u0431\u0435\u043B/esc - \u043F\u0430\u0443\u0437\u0430)\r\n\u041D\u0430\u0434\u043E
    \u0434\u043E\u0439\u0442\u0438 (WASD) \u0434\u043E <b><u>\u0431\u0435\u043B\u043E\u0433\u043E
    \u0442\u0440\u043E\u043D\u0430...</u></b>\r\n\u0421\u0442\u043E\u0438\u0442 \u043F\u0440\u0438\u0441\u043B\u0443\u0448\u0438\u0432\u0430\u0442\u044C\u0441\u044F
    (\u041B\u041A\u041C) \u043F\u043E\u0447\u0430\u0449\u0435 - \u0442\u0430\u043A
    \u044F \u043F\u043E\u0439\u043C\u0443, \u043A\u0443\u0434\u0430 \u0438\u0434\u0442\u0438
    (\u0438\u0449\u0438 \u0441\u0442\u0440\u0435\u043B\u043E\u0447\u043A\u0438) \u0438
    \u043D\u0435 \u0432\u043B\u044F\u043F\u0430\u044E\u0441\u044C <b><u>\u0432\u043E
    \u0447\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C</u></b>... \u0438\u043B\u0438
    \u0432 <b><u>\u043A\u043E\u0433\u043E-\u043D\u0438\u0431\u0443\u0434\u044C</u></b>...\r\n\r\n\u041F\u043E\u0433\u043E\u0434\u0438,
    \u0430 \u043D\u0435 \u0441\u043E\u043D \u043B\u0438 \u0432\u0441\u0451 \u044D\u0442\u043E?"
  m_isRightToLeft: 0
