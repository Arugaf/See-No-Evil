  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u0421\u0434\u0435\u043B\u0430\u043D\u043E \u0441 \u043B\u044E\u0431\u043E\u0432\u044C\u044E,
    \u043A\u0430\u0439\u0444\u043E\u043C \u0438 \u043D\u0430 \u0443\u0433\u0430\u0440\u0435
    \u0437\u0430 72 \u0447\u0430\u0441\u0430 \u043D\u0430 Evening Game Jam 2025\r\n\r\n\u043A\u043E\u043C\u0430\u043D\u0434\u0430
    Pumpkin Games:\r\naxelous - \u0433\u0435\u0439\u043C\u0434\u0438\u0437\u0430\u0439\u043D,
    \u043F\u0440\u043E\u0442\u043E\u0442\u0438\u043F \u0443\u0440\u043E\u0432\u043D\u044F\r\nArugaf
    - \u043A\u043E\u0434\r\nMrKukushenok - \u043A\u043E\u0434, \u0448\u0435\u0439\u0434\u0435\u0440\u044B\r\nXlebusheck1
    - \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0430 \u0438 \u043B\u043E\u0432\u0443\u0448\u043A\u0438,
    \u0434\u043E\u0440\u0430\u0431\u043E\u0442\u043A\u0430 \u0443\u0440\u043E\u0432\u043D\u044F\r\nSea_Jelly
    - \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0430 2\r\nRoman NNk - \u043C\u043E\u0434\u0435\u043B\u0438
    \u043E\u043A\u0440\u0443\u0436\u0435\u043D\u0438\u044F\r\nKH21 - \u0437\u0432\u0443\u043A\u0438
    \u0438 \u043C\u0443\u0437\u044B\u043A\u0430\r\n\r\n\u041F\u0430\u043C\u043F\u043A\u0438\u043D
    - \u043D\u0430\u0448 CEO \u0438 \u0433\u043B\u0430\u0432\u043D\u044B\u0439 \u043A\u043E\u0442
    \u043A\u043E\u043C\u0430\u043D\u0434\u044B!\r\n\r\n\u0421\u043F\u0430\u0441\u0438\u0431\u043E
    \u0437\u0430 \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0443, \u0431\u0443\u0434\u0435\u043C
    \u0440\u0430\u0434\u044B \u0443\u0441\u043B\u044B\u0448\u0430\u0442\u044C \u0432\u0430\u0448\u0443
    \u043E\u0431\u0440\u0430\u0442\u043D\u0443\u044E \u0441\u0432\u044F\u0437\u044C
    \u043D\u0430 \u0438\u0442\u0447\u0435! <3"
  m_isRightToLeft: 0
