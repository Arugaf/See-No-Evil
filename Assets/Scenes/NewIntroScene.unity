  m_text: "\u041A\u0430\u043A \u0438\u0433\u0440\u0430\u0442\u044C:\r\nWASD - \u043F\u0435\u0440\u0435\u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435\r\n\u041C\u044B\u0448\u044C
